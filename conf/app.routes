# microservice specific routes

GET        /ping                                                                             uk.gov.hmrc.vapingdutystubs.controllers.PingController.ping

### Contact Preferences ###

# 1644
GET        /etmp/RESTAdapter/vpd/subscription/:idValue                                       uk.gov.hmrc.vapingdutystubs.controllers.SubscriptionSummaryController.getSubscriptionSummary(idValue)

# 1608
PUT        /etmp/RESTAdapter/email-contact-preference/:regime/:idType/:idValue               uk.gov.hmrc.vapingdutystubs.controllers.contactPreference.EmailContactPreferencesController.submitPreferences(regime, idType, idValue)

# Email verification
GET        /email-verification/verification-status/:credId                                   uk.gov.hmrc.vapingdutystubs.controllers.contactPreference.EmailVerificationController.getVerifiedEmails(credId)

### Obligations ###

GET        /etmp/RESTAdapter/cross-regime/taxpayer-obligations                               uk.gov.hmrc.vapingdutystubs.controllers.ObligationsController.get()

### Returns ###
POST       /etmp/RESTAdapter/vpd/returns                                                     uk.gov.hmrc.vapingdutystubs.controllers.returns.SubmitReturnController.submitReturn()
GET        /etmp/RESTAdapter/vpd/returns/:vpdReference/:periodKey                            uk.gov.hmrc.vapingdutystubs.controllers.returns.ViewReturnController.viewReturn(vpdReference: String, periodKey: String)

### Financial Data ###
POST       /etmp/RESTAdapter/cross-regime/taxpayer/financial-data/query                      uk.gov.hmrc.vapingdutystubs.controllers.FinancialDataController.query()
